#!/bin/sh
# Resolve our own real path, following symlinks, so this works when invoked
# from PATH (e.g. `ledger-web` installed via scripts/install.sh).
if command -v perl >/dev/null 2>&1; then
  SELF="$(perl -MCwd=abs_path -e 'print Cwd::abs_path($ARGV[0])' "$0" 2>/dev/null)"
  SELF="${SELF:-$0}"
else
  SELF="$0"
fi
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"

# Data dir from first argument, or from the DATA_DIR env var.
if [ -n "$1" ]; then
  export DATA_DIR="$1"
  shift
elif [ -z "$DATA_DIR" ]; then
  echo "Error: no data directory given" >&2
  echo "Usage: $0 /path/to/data [args...]" >&2
  echo "   or: DATA_DIR=/path/to/data $0 [args...]" >&2
  exit 1
fi

export LEDGER_FILE="${DATA_DIR}/main.journal"
cd "$SCRIPT_DIR"

# Auto-build on first run or after a fresh clone.
if [ ! -f build/index.js ]; then
  echo "Build not found - running pnpm build..." >&2
  rm -rf .svelte-kit
  pnpm build || exit 1
fi

node build/index.js "$@" &
PID=$!
cleanup() {
  kill "$PID" 2>/dev/null
  exit 0
}

trap cleanup SIGINT SIGTERM

wait $PID
